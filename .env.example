# Copy to `.env` (gitignored) and fill in whatever you have. Both the Python
# runtime and the Wolfram side (examples/wolfram/llm.wls) read these.
#
# You need ONLY ONE working backend. The default `--backend auto` picks whatever
# is available. Run `llmgraph doctor` to see what's configured and what's missing.
#
# No key at all? Use the Claude Code CLI backend — just `claude /login`, then
# `--backend claude-cli` (or let auto pick it). It needs NO API key.

# Qwen / 通义千问 (DashScope OpenAI-compatible). Pay-as-you-go account:
DASHSCOPE_API_KEY=

# Qwen token-plan account (prepaid resource package). Used by backend "qwen-tokenplan":
DASHSCOPE_TOKENPLAN_API_KEY=

# DeepSeek (OpenAI-compatible). Used by backend "deepseek" and Wolfram deepseek_config.wls:
DEEPSEEK_API_KEY=

# OpenAI. Used by backend "openai":
OPENAI_API_KEY=

# Anthropic API backend (only if you use --backend anthropic; not required otherwise):
ANTHROPIC_API_KEY=

# Optional: override the DashScope endpoint (e.g. the international/Singapore host).
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional: default backend when --backend is not passed on the CLI.
# One of: auto (default) | anthropic | claude-cli | qwen | qwen-tokenplan | openai | deepseek
# LLMGRAPH_BACKEND=qwen
