# Copy to `.env` (gitignored) and fill in. Both the Python runtime and the
# Wolfram side (examples/wolfram/llm.wls) read these.

# Qwen / 通义千问 (DashScope OpenAI-compatible). Pay-as-you-go account:
DASHSCOPE_API_KEY=

# Qwen token-plan account (prepaid resource package). Used by backend "qwen-tokenplan":
DASHSCOPE_TOKENPLAN_API_KEY=

# DeepSeek (OpenAI-compatible). Used by backend "deepseek" and Wolfram deepseek_config.wls:
DEEPSEEK_API_KEY=

# Optional: override the DashScope endpoint (e.g. the international/Singapore host).
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional: default backend when --backend is not passed on the CLI.
# One of: anthropic | claude-cli | qwen | qwen-tokenplan
# LLMGRAPH_BACKEND=qwen

# Anthropic API backend (only if you use --backend anthropic):
# ANTHROPIC_API_KEY=
